# Streamlit Secrets 템플릿
#   [Cloud 배포] share.streamlit.io → 앱 Settings → Secrets에 아래 내용을 채워 붙여넣기
#   [로컬 테스트] 이 파일을 secrets.toml로 복사해 값 입력 (secrets.toml은 .gitignore로 제외됨)
# 실제 값이 들어간 파일은 절대 GitHub에 올리지 말 것.

# 1. 구글 로그인 — Google Cloud 콘솔 > 사용자 인증 정보 > OAuth 클라이언트 ID (유형: 웹 애플리케이션)
#    '승인된 리디렉션 URI'에 아래 redirect_uri와 똑같은 주소(앱 주소, 끝의 / 포함)를 등록
[oauth]
client_id = "1234567890-abcdefg.apps.googleusercontent.com"
client_secret = "GOCSPX-your_secret_here"
redirect_uri = "https://your-app-name.streamlit.app/"

# 2. 앱 설정
[app]
# 받는 사람 구글 시트 ID. 앱의 '② 받는 사람' 탭에서 시트를 만든 뒤 나오는 값을 넣는다.
# (시트 주소 https://docs.google.com/spreadsheets/d/<이 부분>/edit)
recipients_sheet_id = ""
# '세미나·IR' 캘린더 ID(선택). 비워 두면 로그인한 사람 계정에서 찾거나 새로 만든다.
calendar_id = ""
